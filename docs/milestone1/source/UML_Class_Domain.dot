digraph Domain {
graph [rankdir=TB, label="UML Class Diagram - Domain Model (package model)\nOrange classes = junction classes for the many-to-many relationships (Player-Team, Team-Tournament, Player-Match)"];
graph [fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.5, ranksep=0.9];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#444444"];

edge [dir=none, arrowhead=none];
UserAccount [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF1FA"><B>UserAccount</B></TD></TR><TR><TD ALIGN="LEFT">-userId: int<BR ALIGN='LEFT'/>-username: String<BR ALIGN='LEFT'/>-passwordHash: String<BR ALIGN='LEFT'/>-passwordSalt: String<BR ALIGN='LEFT'/>-role: Role<BR ALIGN='LEFT'/>-email: String<BR ALIGN='LEFT'/>-active: boolean<BR ALIGN='LEFT'/>-createdAt: LocalDateTime<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT">+getRole(): Role<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
Director [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF1FA"><B>Director</B></TD></TR><TR><TD ALIGN="LEFT">-directorId: int<BR ALIGN='LEFT'/>-userId: int<BR ALIGN='LEFT'/>-firstName: String<BR ALIGN='LEFT'/>-lastName: String<BR ALIGN='LEFT'/>-phone: String<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT">+getFullName(): String<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
Coach [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF1FA"><B>Coach</B></TD></TR><TR><TD ALIGN="LEFT">-coachId: int<BR ALIGN='LEFT'/>-userId: int<BR ALIGN='LEFT'/>-firstName: String<BR ALIGN='LEFT'/>-lastName: String<BR ALIGN='LEFT'/>-phone: String<BR ALIGN='LEFT'/>-yearsExperience: int<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT">+getFullName(): String<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
Player [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF1FA"><B>Player</B></TD></TR><TR><TD ALIGN="LEFT">-playerId: int<BR ALIGN='LEFT'/>-userId: int<BR ALIGN='LEFT'/>-firstName: String<BR ALIGN='LEFT'/>-lastName: String<BR ALIGN='LEFT'/>-gamerTag: String<BR ALIGN='LEFT'/>-dateOfBirth: LocalDate<BR ALIGN='LEFT'/>-country: String<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT">+getFullName(): String<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
Game [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF1FA"><B>Game</B></TD></TR><TR><TD ALIGN="LEFT">-gameId: int<BR ALIGN='LEFT'/>-gameName: String<BR ALIGN='LEFT'/>-genre: String<BR ALIGN='LEFT'/>-publisher: String<BR ALIGN='LEFT'/>-playersPerTeam: int<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
Team [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF1FA"><B>Team</B></TD></TR><TR><TD ALIGN="LEFT">-teamId: int<BR ALIGN='LEFT'/>-teamName: String<BR ALIGN='LEFT'/>-gameId: int<BR ALIGN='LEFT'/>-coachId: int<BR ALIGN='LEFT'/>-region: String<BR ALIGN='LEFT'/>-foundedDate: LocalDate<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
Tournament [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF1FA"><B>Tournament</B></TD></TR><TR><TD ALIGN="LEFT">-tournamentId: int<BR ALIGN='LEFT'/>-tournamentName: String<BR ALIGN='LEFT'/>-gameId: int<BR ALIGN='LEFT'/>-directorId: int<BR ALIGN='LEFT'/>-startDate: LocalDate<BR ALIGN='LEFT'/>-endDate: LocalDate<BR ALIGN='LEFT'/>-location: String<BR ALIGN='LEFT'/>-prizePool: BigDecimal<BR ALIGN='LEFT'/>-maxTeams: int<BR ALIGN='LEFT'/>-status: String<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
TournamentMatch [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF1FA"><B>TournamentMatch</B></TD></TR><TR><TD ALIGN="LEFT">-matchId: int<BR ALIGN='LEFT'/>-tournamentId: int<BR ALIGN='LEFT'/>-roundName: String<BR ALIGN='LEFT'/>-scheduledAt: LocalDateTime<BR ALIGN='LEFT'/>-venue: String<BR ALIGN='LEFT'/>-homeTeamId: int<BR ALIGN='LEFT'/>-awayTeamId: int<BR ALIGN='LEFT'/>-homeScore: Integer<BR ALIGN='LEFT'/>-awayScore: Integer<BR ALIGN='LEFT'/>-status: String<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT">+getWinnerTeamId(): Integer<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
TeamMembership [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFF4E3"><TR><TD BGCOLOR="#EAF1FA"><B>TeamMembership</B></TD></TR><TR><TD ALIGN="LEFT">-teamId: int<BR ALIGN='LEFT'/>-playerId: int<BR ALIGN='LEFT'/>-joinDate: LocalDate<BR ALIGN='LEFT'/>-leaveDate: LocalDate<BR ALIGN='LEFT'/>-teamRole: String<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT">+isCurrent(): boolean<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
TournamentRegistration [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFF4E3"><TR><TD BGCOLOR="#EAF1FA"><B>TournamentRegistration</B></TD></TR><TR><TD ALIGN="LEFT">-tournamentId: int<BR ALIGN='LEFT'/>-teamId: int<BR ALIGN='LEFT'/>-registrationDate: LocalDate<BR ALIGN='LEFT'/>-seedNumber: Integer<BR ALIGN='LEFT'/>-status: String<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
PlayerMatchStat [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFF4E3"><TR><TD BGCOLOR="#EAF1FA"><B>PlayerMatchStat</B></TD></TR><TR><TD ALIGN="LEFT">-matchId: int<BR ALIGN='LEFT'/>-playerId: int<BR ALIGN='LEFT'/>-kills: int<BR ALIGN='LEFT'/>-deaths: int<BR ALIGN='LEFT'/>-assists: int<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT">+getKdRatio(): double<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
Role [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF1FA"><FONT POINT-SIZE="9">&laquo;enumeration&raquo;</FONT><BR/><B>Role</B></TD></TR><TR><TD ALIGN="LEFT">DIRECTOR<BR ALIGN='LEFT'/>COACH<BR ALIGN='LEFT'/>PLAYER<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
UserAccount -> Director [taillabel="1", headlabel="0..1", label="", labeldistance=1.6];
UserAccount -> Coach [taillabel="1", headlabel="0..1", label="", labeldistance=1.6];
UserAccount -> Player [taillabel="1", headlabel="0..1", label="", labeldistance=1.6];
Coach -> Team [taillabel="1", headlabel="0..*", label="manages", labeldistance=1.6];
Game -> Team [taillabel="1", headlabel="*", label="played by", labeldistance=1.6];
Game -> Tournament [taillabel="1", headlabel="*", label="featured in", labeldistance=1.6];
Director -> Tournament [taillabel="1", headlabel="*", label="runs", labeldistance=1.6];
Tournament -> TournamentMatch [taillabel="1", headlabel="*", label="schedules", labeldistance=1.6];
Team -> TournamentMatch [taillabel="2", headlabel="*", label="home / away", labeldistance=1.6];
Player -> TeamMembership [taillabel="1", headlabel="*", label="", labeldistance=1.6];
TeamMembership -> Team [taillabel="*", headlabel="1", label="", labeldistance=1.6];
Team -> TournamentRegistration [taillabel="1", headlabel="*", label="", labeldistance=1.6];
TournamentRegistration -> Tournament [taillabel="*", headlabel="1", label="", labeldistance=1.6];
Player -> PlayerMatchStat [taillabel="1", headlabel="*", label="", labeldistance=1.6];
PlayerMatchStat -> TournamentMatch [taillabel="*", headlabel="1", label="", labeldistance=1.6];
UserAccount -> Role [dir=forward, arrowhead=vee, style=solid, label="uses"];
}