graph UseCases {
graph [rankdir=LR, label="UML Use Case Diagram - Esports Tournament Management System", fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.25, ranksep=1.2];
node [fontname="Helvetica", fontsize=10]; edge [color="#555555"];
Director [shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2B5C8A", label="&#9786;\nDirector", fontsize=13, width=1.2, height=0.9];
Coach [shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2B5C8A", label="&#9786;\nCoach", fontsize=13, width=1.2, height=0.9];
Player [shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2B5C8A", label="&#9786;\nPlayer", fontsize=13, width=1.2, height=0.9];
User [shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2B5C8A", label="&#9786;\nUser", fontsize=13, width=1.2, height=0.9];
subgraph cluster_sys { label="Esports Tournament Management System"; style=rounded; color="#2B5C8A"; fontsize=13;
uc1 [shape=ellipse, style=filled, fillcolor="#E3F1E3", label="Log in"];
uc2 [shape=ellipse, style=filled, fillcolor="#E3F1E3", label="Log out"];
uc3 [shape=ellipse, style=filled, fillcolor="#E3F1E3", label="View tournament standings"];
uc4 [shape=ellipse, style=filled, fillcolor="#E3F1E3", label="View match schedule"];
uc5 [shape=ellipse, style=filled, fillcolor="#E3F1E3", label="View player statistics"];
uc6 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="Create / edit / delete tournament"];
uc7 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="Schedule / edit / cancel match"];
uc8 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="Record match result"];
uc9 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="Register team for tournament"];
uc10 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="Create user accounts"];
uc11 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="Search tournaments, teams and players"];
uc12 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="View registrations report"];
uc13 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="View team rosters"];
uc14 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="View my teams and rosters"];
uc15 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="Add player to team"];
uc16 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="Remove player from team"];
uc17 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="Register my team for tournament"];
uc18 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="Edit team details"];
uc19 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="View my profile"];
uc20 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="Update my profile"];
uc21 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="View my teams"];
uc22 [shape=ellipse, style=filled, fillcolor="#FFFFFF", label="View my statistics"];
}
User -- uc1;
User -- uc2;
User -- uc3;
User -- uc4;
User -- uc5;
Director -- uc6;
Director -- uc7;
Director -- uc8;
Director -- uc9;
Director -- uc10;
Director -- uc11;
Director -- uc12;
Director -- uc13;
Coach -- uc14;
Coach -- uc15;
Coach -- uc16;
Coach -- uc17;
Coach -- uc18;
Player -- uc19;
Player -- uc20;
Player -- uc21;
Player -- uc22;
Director -- User [dir=forward, arrowhead=empty, arrowsize=1.4, constraint=false];
Coach -- User [dir=forward, arrowhead=empty, arrowsize=1.4, constraint=false];
Player -- User [dir=forward, arrowhead=empty, arrowsize=1.4, constraint=false];
label_note [shape=note, fontsize=9, label="Director, Coach and Player are all Users\n(hollow arrow = generalisation)\nso they share the green use cases."];
}