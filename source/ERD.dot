digraph ERD {
graph [rankdir=TB, splines=spline, nodesep=0.55, ranksep=0.7, fontname="Helvetica", label="Esports Tournament Management System - Entity Relationship Diagram (crow's foot)\nBlue = user and profile tables, green = core tables, orange = junction tables for many-to-many relationships", labelloc=t, fontsize=20, pad=0.4];
node [shape=plaintext, fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica", fontsize=9, color="#555555", dir=both];
UserAccount [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DCE9F7" COLOR="#2B5C8A"><TR><TD BGCOLOR="#2B5C8A" COLSPAN="3"><FONT COLOR="white"><B>UserAccount</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">PK</TD><TD ALIGN="LEFT"><B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username"></TD><TD ALIGN="LEFT">username (U)</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash"></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">char(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_salt"></TD><TD ALIGN="LEFT">password_salt</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">char(32)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role"></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum('DIRECTOR','COACH','PLAYER')</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email"></TD><TD ALIGN="LEFT">email (U)</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR></TABLE>>];
Director [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DCE9F7" COLOR="#2B5C8A"><TR><TD BGCOLOR="#2B5C8A" COLSPAN="3"><FONT COLOR="white"><B>Director</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="director_id">PK</TD><TD ALIGN="LEFT"><B>director_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">FK</TD><TD ALIGN="LEFT">user_id (U)</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name"></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name"></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone"></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(20)</FONT></TD></TR></TABLE>>];
Coach [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DCE9F7" COLOR="#2B5C8A"><TR><TD BGCOLOR="#2B5C8A" COLSPAN="3"><FONT COLOR="white"><B>Coach</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="coach_id">PK</TD><TD ALIGN="LEFT"><B>coach_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">FK</TD><TD ALIGN="LEFT">user_id (U)</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name"></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name"></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone"></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="years_experience"></TD><TD ALIGN="LEFT">years_experience</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint</FONT></TD></TR></TABLE>>];
Player [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DCE9F7" COLOR="#2B5C8A"><TR><TD BGCOLOR="#2B5C8A" COLSPAN="3"><FONT COLOR="white"><B>Player</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id">PK</TD><TD ALIGN="LEFT"><B>player_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">FK</TD><TD ALIGN="LEFT">user_id (U)</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name"></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name"></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="gamer_tag"></TD><TD ALIGN="LEFT">gamer_tag (U)</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_of_birth"></TD><TD ALIGN="LEFT">date_of_birth</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="country"></TD><TD ALIGN="LEFT">country</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD></TR></TABLE>>];
Game [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F1E3" COLOR="#3A7A3A"><TR><TD BGCOLOR="#3A7A3A" COLSPAN="3"><FONT COLOR="white"><B>Game</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id">PK</TD><TD ALIGN="LEFT"><B>game_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_name"></TD><TD ALIGN="LEFT">game_name (U)</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="genre"></TD><TD ALIGN="LEFT">genre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="publisher"></TD><TD ALIGN="LEFT">publisher</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="players_per_team"></TD><TD ALIGN="LEFT">players_per_team</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint</FONT></TD></TR></TABLE>>];
Team [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F1E3" COLOR="#3A7A3A"><TR><TD BGCOLOR="#3A7A3A" COLSPAN="3"><FONT COLOR="white"><B>Team</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id">PK</TD><TD ALIGN="LEFT"><B>team_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_name"></TD><TD ALIGN="LEFT">team_name (U)</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id">FK</TD><TD ALIGN="LEFT">game_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="coach_id">FK</TD><TD ALIGN="LEFT">coach_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="region"></TD><TD ALIGN="LEFT">region</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="founded_date"></TD><TD ALIGN="LEFT">founded_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD></TR></TABLE>>];
TeamMembership [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDE7C8" COLOR="#C77700"><TR><TD BGCOLOR="#C77700" COLSPAN="3"><FONT COLOR="white"><B>TeamMembership</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id">PK, FK</TD><TD ALIGN="LEFT"><B>team_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id">PK, FK</TD><TD ALIGN="LEFT"><B>player_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="join_date">PK</TD><TD ALIGN="LEFT"><B>join_date</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="leave_date"></TD><TD ALIGN="LEFT">leave_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_role"></TD><TD ALIGN="LEFT">team_role</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD></TR></TABLE>>];
Tournament [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F1E3" COLOR="#3A7A3A"><TR><TD BGCOLOR="#3A7A3A" COLSPAN="3"><FONT COLOR="white"><B>Tournament</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tournament_id">PK</TD><TD ALIGN="LEFT"><B>tournament_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tournament_name"></TD><TD ALIGN="LEFT">tournament_name (U)</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="game_id">FK</TD><TD ALIGN="LEFT">game_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="director_id">FK</TD><TD ALIGN="LEFT">director_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="start_date"></TD><TD ALIGN="LEFT">start_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="end_date"></TD><TD ALIGN="LEFT">end_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="location"></TD><TD ALIGN="LEFT">location</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prize_pool"></TD><TD ALIGN="LEFT">prize_pool</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="max_teams"></TD><TD ALIGN="LEFT">max_teams</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum('UPCOMING','ONGOING','COMPLETED')</FONT></TD></TR></TABLE>>];
TournamentRegistration [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDE7C8" COLOR="#C77700"><TR><TD BGCOLOR="#C77700" COLSPAN="3"><FONT COLOR="white"><B>TournamentRegistration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tournament_id">PK, FK</TD><TD ALIGN="LEFT"><B>tournament_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="team_id">PK, FK</TD><TD ALIGN="LEFT"><B>team_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="registration_date"></TD><TD ALIGN="LEFT">registration_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="seed_number"></TD><TD ALIGN="LEFT">seed_number</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum('PENDING','CONFIRMED','WITHDRAWN')</FONT></TD></TR></TABLE>>];
TournamentMatch [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F1E3" COLOR="#3A7A3A"><TR><TD BGCOLOR="#3A7A3A" COLSPAN="3"><FONT COLOR="white"><B>TournamentMatch</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="match_id">PK</TD><TD ALIGN="LEFT"><B>match_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tournament_id">FK</TD><TD ALIGN="LEFT">tournament_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="round_name"></TD><TD ALIGN="LEFT">round_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="scheduled_at"></TD><TD ALIGN="LEFT">scheduled_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="venue"></TD><TD ALIGN="LEFT">venue</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="home_team_id">FK</TD><TD ALIGN="LEFT">home_team_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="away_team_id">FK</TD><TD ALIGN="LEFT">away_team_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="home_score"></TD><TD ALIGN="LEFT">home_score</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="away_score"></TD><TD ALIGN="LEFT">away_score</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum('SCHEDULED','COMPLETED','CANCELLED')</FONT></TD></TR></TABLE>>];
PlayerMatchStat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDE7C8" COLOR="#C77700"><TR><TD BGCOLOR="#C77700" COLSPAN="3"><FONT COLOR="white"><B>PlayerMatchStat</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="match_id">PK, FK</TD><TD ALIGN="LEFT"><B>match_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="player_id">PK, FK</TD><TD ALIGN="LEFT"><B>player_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kills"></TD><TD ALIGN="LEFT">kills</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="deaths"></TD><TD ALIGN="LEFT">deaths</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="assists"></TD><TD ALIGN="LEFT">assists</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint</FONT></TD></TR></TABLE>>];
UserAccount -> Coach [arrowtail=teetee, arrowhead=teeodot];
UserAccount -> Director [arrowtail=teetee, arrowhead=teeodot];
UserAccount -> Player [arrowtail=teetee, arrowhead=teeodot];
TournamentMatch -> PlayerMatchStat [arrowtail=teetee, arrowhead=crowodot];
Player -> PlayerMatchStat [arrowtail=teetee, arrowhead=crowodot];
Coach -> Team [arrowtail=teetee, arrowhead=crowodot];
Game -> Team [arrowtail=teetee, arrowhead=crowodot];
Player -> TeamMembership [arrowtail=teetee, arrowhead=crowodot];
Team -> TeamMembership [arrowtail=teetee, arrowhead=crowodot];
Director -> Tournament [arrowtail=teetee, arrowhead=crowodot];
Game -> Tournament [arrowtail=teetee, arrowhead=crowodot];
TournamentRegistration -> TournamentMatch [arrowtail=teetee, arrowhead=crowodot, label="(away team)"];
TournamentRegistration -> TournamentMatch [arrowtail=teetee, arrowhead=crowodot, label="(home team)"];
Team -> TournamentRegistration [arrowtail=teetee, arrowhead=crowodot];
Tournament -> TournamentRegistration [arrowtail=teetee, arrowhead=crowodot];
}