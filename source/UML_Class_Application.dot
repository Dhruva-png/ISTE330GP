LoginScreen [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF1FA"><FONT POINT-SIZE="9">&laquo;UI&raquo;</FONT><BR/><B>LoginScreen</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">+show(): UserAccount<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
