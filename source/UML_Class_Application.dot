digraph AppClasses {
graph [rankdir=TB, label="UML Class Diagram - Application Structure (initial design)\nModel classes are shown in the separate domain model diagram", newrank=true];
graph [fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.5, ranksep=0.9];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#444444"];

subgraph cluster_0 { label="package app"; style="rounded,dashed"; color="#888888"; fontsize=12;
Main [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF1FA"><FONT POINT-SIZE="9">&laquo;entry point&raquo;</FONT><BR/><B>Main</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">+main(args: String[]): void<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
}
