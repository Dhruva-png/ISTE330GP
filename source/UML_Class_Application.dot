CoachMenu [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2B5C8A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF1FA"><FONT POINT-SIZE="9">&laquo;UI&raquo;</FONT><BR/><B>CoachMenu</B></TD></TR><TR><TD ALIGN="LEFT">-user: UserAccount<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT">+show(): void<BR ALIGN='LEFT'/>-viewMyTeams()<BR ALIGN='LEFT'/>-addPlayerToTeam()<BR ALIGN='LEFT'/>-removePlayer()<BR ALIGN='LEFT'/>-editTeamDetails()<BR ALIGN='LEFT'/>-registerForTournament()<BR ALIGN='LEFT'/>-viewReports()<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
